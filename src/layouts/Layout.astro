---
// src/layouts/Layout.astro

import "../styles/global.css"
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
}

const {
  title,
  description = "Sitios web de alto rendimiento, dashboards Power BI y automatización de procesos para PYMEs en Chile. Landing pages listas en 10 días.",
  ogImage = "/og-image.png",
  canonicalURL = Astro.url.href,
} = Astro.props;

const siteName = "DatAImpulsa";
const fullTitle = title === "Inicio" ? `DatAImpulsa — Sitios Web y Business Intelligence para PYMEs en Chile` : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:image" content="https://dataimpulsa.cl/og-image.jpg" />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "DatAImpulsa",
      "url": "https://dataimpulsa.cl",
      "logo": "https://dataimpulsa.cl/logo.png",
      "description": description,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Ahumada 236 Of. 501",
        "addressLocality": "Santiago",
        "addressCountry": "CL"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+56988574082",
        "email": "contacto@dataimpulsa.cl",
        "contactType": "sales"
      },
      "sameAs": [
        "https://www.linkedin.com/company/dataimpulsa"
      ]
    })} />
  </head>
  <body class="font-(--font-display) bg-(--color-deep) text-(--color-text-primary)">
    <div class="grid-bg"></div>
    <slot />

    <!-- Scroll Reveal Observer -->
    <script>
  // --- Theme Toggle ---
  const theme = (() => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return "dark";
  })();

  document.documentElement.classList.toggle("light", theme === "light");

  function updateIcons() {
    const isLight = document.documentElement.classList.contains("light");
    const iconDark = document.getElementById("icon-dark");
    const iconLight = document.getElementById("icon-light");
    if (iconDark) iconDark.style.display = isLight ? "none" : "block";
    if (iconLight) iconLight.style.display = isLight ? "block" : "none";
  }

  updateIcons();

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const isLight = document.documentElement.classList.toggle("light");
    localStorage.setItem("theme", isLight ? "light" : "dark");
    updateIcons();
  });

  // --- Scroll Reveal ---
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
  );

  document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
</script>
  </body>
</html>