---
// src/layouts/Layout.astro
import "../styles/global.css"
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Sitios web de alto rendimiento, dashboards Power BI y automatización de procesos para PYMEs en Chile. Landing pages listas en 10 días.",
  ogImage = "/og-image.jpg",
  canonicalURL = Astro.url.href,
  noindex = false,
} = Astro.props;

const siteName = "DatAImpulsa";
const fullTitle = title === "Inicio" ? `DatAImpulsa — Sitios Web y Business Intelligence para PYMEs en Chile` : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts (self-hosted) — solo preload de la fuente del H1 (LCP) -->
    <link rel="preload" href="/fonts/space-grotesk-variable-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "DatAImpulsa",
      "url": "https://dataimpulsa.cl",
      "logo": "https://dataimpulsa.cl/logo.png",
      "description": description,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Ahumada 236 Of. 501",
        "addressLocality": "Santiago",
        "addressCountry": "CL"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+56988574082",
        "email": "contacto@dataimpulsa.cl",
        "contactType": "sales"
      },
      "sameAs": [
        "https://www.linkedin.com/company/dataimpulsa"
      ]
    })} />
  </head>
  <body class="font-body bg-(--color-deep) text-(--color-text-primary)">
    <div class="grid-bg"></div>
    <slot />

    <script is:inline>
  // Marca que JS está activo (para CSS)
  document.documentElement.classList.add("js");

  // --- Theme Toggle ---
  const theme = (() => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return "light";
  })();

  document.documentElement.classList.toggle("light", theme === "light");

  function updateIcons() {
    const isLight = document.documentElement.classList.contains("light");
    const iconDark = document.getElementById("icon-dark");
    const iconLight = document.getElementById("icon-light");
    if (iconDark) iconDark.style.display = isLight ? "none" : "block";
    if (iconLight) iconLight.style.display = isLight ? "block" : "none";
  }

  function initThemeToggle() {
    updateIcons();
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const isLight = document.documentElement.classList.toggle("light");
      localStorage.setItem("theme", isLight ? "light" : "dark");
      updateIcons();
    });
  }

  // --- Scroll Reveal FIX MOBILE ---
  function initReveal() {
    const els = document.querySelectorAll(".reveal");
    if (!els.length) return;

    // Accesibilidad: si el usuario pide menos movimiento, mostrar todo
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }

    if (!("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }

    // Observer optimizado para mobile: threshold 0 + rootMargin en %
    // - threshold 0 es independiente del alto del viewport (fix para celulares cortos)
    // - rootMargin 15% dispara antes de que el elemento esté totalmente visible
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { 
        threshold: 0, 
        rootMargin: "0px 0px -10% 0px" 
      }
    );

    els.forEach((el) => observer.observe(el));
    
    // Fallback: si algo no se observó en 3s (scroll muy rápido en iOS), forzar visible
    setTimeout(() => {
      els.forEach((el) => {
        if (!el.classList.contains("is-visible")) {
          el.classList.add("is-visible");
        }
      });
    }, 3000);
  }

  function boot() {
    initThemeToggle();
    // Esperar a que el layout se estabilice (fix barra de Chrome en Android/iOS)
    requestAnimationFrame(() => {
      setTimeout(initReveal, 80);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }

  // Soporte View Transitions de Astro
  document.addEventListener("astro:page-load", boot);
    </script>
  </body>
</html>
