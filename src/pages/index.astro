---
// src/pages/index.astro
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/layout/Navbar.astro";
import Footer from "@components/layout/Footer.astro";
import Hero from "@components/sections/Hero.astro";
import StatsBar from "@components/sections/StatsBar.astro";
import Services from "@components/sections/Services.astro";
import Technology from "@components/sections/Technology.astro";
import Process from "@components/sections/Process.astro";
import SuccessCases from "@components/sections/SuccessCases.astro";
import DataServices from "@components/sections/DataServices.astro";
import CtaBanner from "@components/sections/CtaBanner.astro";
import Contact from "@components/sections/Contact.astro";
---

<Layout title="Inicio">
  <Navbar activeLink="inicio" />
  <main>
    <Hero />
    <StatsBar />
    <Services />
    <Technology />
    <Process />
    <SuccessCases />
    <DataServices />
    <CtaBanner />
    <Contact />
  </main>
  <Footer />
</Layout>
