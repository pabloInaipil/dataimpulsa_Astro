---
// src/pages/suspendido.astro
// ─────────────────────────────────────────────────────────────
// Página de suspensión de servicio.
// Se usa como destino de Cloudflare Redirect Rules (302)
// cuando un cliente tiene pagos pendientes.
//
// ⚠️ NO mencionar nombres de clientes, montos ni deudas.
//     El contenido debe ser genérico y profesional.
// ─────────────────────────────────────────────────────────────
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Servicio Suspendido — DatAImpulsa</title>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    /* ─── Reset ───────────────────────────────── */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    /* ─── Palette ─────────────────────────────── */
    :root {
      --primary: #7C3AED;
      --primary-dark: #5B21B6;
      --primary-glow: rgba(124, 58, 237, 0.15);
      --danger: #EF4444;
      --danger-soft: #FEE2E2;
      --surface: #0B0F1A;
      --surface-card: #111827;
      --surface-card-border: rgba(255,255,255,0.06);
      --text: #F1F5F9;
      --text-muted: #94A3B8;
      --text-dim: #64748B;
    }

    /* ─── Page ────────────────────────────────── */
    html { height: 100%; }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background: var(--surface);
      color: var(--text);
      padding: 24px;
      position: relative;
      overflow: hidden;
    }

    /* ─── Ambient glow ────────────────────────── */
    body::before {
      content: '';
      position: absolute;
      top: -200px;
      left: 50%;
      transform: translateX(-50%);
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, var(--primary-glow) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    body::after {
      content: '';
      position: absolute;
      bottom: -300px;
      right: -200px;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(239, 68, 68, 0.06) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    /* ─── Card container ──────────────────────── */
    .card {
      position: relative;
      z-index: 1;
      max-width: 520px;
      width: 100%;
      background: var(--surface-card);
      border: 1px solid var(--surface-card-border);
      border-radius: 20px;
      padding: 48px 40px;
      text-align: center;
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.03),
        0 20px 60px rgba(0,0,0,0.5);
      animation: fadeUp 0.6s ease-out both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ─── Icon ────────────────────────────────── */
    .icon-wrapper {
      width: 72px;
      height: 72px;
      margin: 0 auto 24px;
      border-radius: 50%;
      background: var(--danger-soft);
      display: flex;
      align-items: center;
      justify-content: center;
      animation: pulse-ring 2.5s ease-in-out infinite;
    }

    @keyframes pulse-ring {
      0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.15); }
      50%      { box-shadow: 0 0 0 14px rgba(239, 68, 68, 0); }
    }

    .icon-wrapper svg {
      width: 36px;
      height: 36px;
      color: var(--danger);
    }

    /* ─── Typography ──────────────────────────── */
    h1 {
      font-size: 1.75rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.2;
      margin-bottom: 12px;
      color: var(--text);
    }

    .subtitle {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--text-muted);
      margin-bottom: 32px;
    }

    /* ─── Divider ─────────────────────────────── */
    .divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--surface-card-border), transparent);
      margin: 0 -8px 28px;
    }

    /* ─── Contact info ────────────────────────── */
    .contact-label {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-bottom: 16px;
    }

    .contact-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 12px;
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .contact-row svg {
      width: 18px;
      height: 18px;
      color: var(--primary);
      flex-shrink: 0;
    }

    .contact-row a {
      color: var(--text);
      text-decoration: none;
      transition: color 0.2s;
    }

    .contact-row a:hover {
      color: var(--primary);
    }

    /* ─── CTA Button ──────────────────────────── */
    .cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 24px;
      padding: 14px 28px;
      background: var(--primary);
      color: #FFFFFF;
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 700;
      border: none;
      border-radius: 12px;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 4px 16px rgba(124, 58, 237, 0.35);
    }

    .cta:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
      box-shadow: 0 6px 24px rgba(124, 58, 237, 0.45);
    }

    .cta svg {
      width: 20px;
      height: 20px;
    }

    /* ─── Footer ──────────────────────────────── */
    .footer {
      position: relative;
      z-index: 1;
      margin-top: 32px;
      text-align: center;
      animation: fadeUp 0.6s ease-out 0.2s both;
    }

    .footer a {
      font-size: 0.8rem;
      color: var(--text-dim);
      text-decoration: none;
      font-weight: 600;
      letter-spacing: 0.05em;
      transition: color 0.2s;
    }

    .footer a:hover {
      color: var(--primary);
    }

    /* ─── Responsive ──────────────────────────── */
    @media (max-width: 480px) {
      .card { padding: 36px 24px; }
      h1 { font-size: 1.4rem; }
      .subtitle { font-size: 0.9rem; }
    }
  </style>
</head>

<body>

  <div class="card">

    <!-- Icon -->
    <div class="icon-wrapper">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4.99c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z" />
      </svg>
    </div>

    <!-- Content -->
    <h1>Servicio Temporalmente Suspendido</h1>
    <p class="subtitle">
      El sitio web que intentas visitar se encuentra suspendido por razones administrativas.
      Si eres el titular de este dominio, por favor comunícate con nosotros para restablecer el servicio.
    </p>

    <div class="divider"></div>

    <!-- Contact -->
    <p class="contact-label">Contacto del administrador</p>

    <div class="contact-row">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      <a href="mailto:dataimpulsa@gmail.com">dataimpulsa@gmail.com</a>
    </div>

    <div class="contact-row">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.66 0 3-4.03 3-9s-1.34-9-3-9m0 18c-1.66 0-3-4.03-3-9s1.34-9 3-9" />
      </svg>
      <a href="https://dataimpulsa.cl">dataimpulsa.cl</a>
    </div>

    <!-- WhatsApp CTA -->
    <a href="https://wa.me/56988574082?text=Hola%2C%20necesito%20reactivar%20mi%20sitio%20web."
       class="cta" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      Contactar por WhatsApp
    </a>

  </div>

  <!-- Footer -->
  <div class="footer">
    <a href="https://dataimpulsa.cl">
      DatAImpulsa — Desarrollo Web · Datos · Automatización · IA
    </a>
  </div>

</body>
</html>