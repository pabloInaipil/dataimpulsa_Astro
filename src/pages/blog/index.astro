---
// src/pages/blog/index.astro
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/layout/Navbar.astro";
import Footer from "@components/layout/Footer.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog"
  description="Artículos sobre Data Analytics, Power BI, automatización y tendencias en Business Intelligence."
>
  <Navbar activeLink="blog" />
  <main>
    <!-- Page Hero -->
    <section class="relative z-[1] pt-32 pb-16 px-6 overflow-hidden">
      <div
        class="absolute -top-[150px] right-[10%] w-[500px] h-[500px] pointer-events-none"
        style="background: radial-gradient(circle, var(--color-violet-glow-strong) 0%, transparent 70%); animation: pulse-glow 8s ease-in-out infinite;"
      ></div>
      <div class="max-w-7xl mx-auto text-center">
        <div class="text-xs font-medium tracking-widest uppercase text-(--color-purple-400) mb-3 font-display">
          // Blog
        </div>
        <h1 class="text-[clamp(2.5rem,5vw,3.5rem)] font-bold leading-tight tracking-tight mb-6">
          Insights sobre <span class="gradient-text">datos y BI</span>
        </h1>
        <p class="text-lg text-(--color-text-secondary) max-w-2xl mx-auto leading-relaxed">
          Artículos, guías y tendencias sobre Business Intelligence, automatización y analítica de datos.
        </p>
      </div>
    </section>

    <!-- Posts Grid -->
    <section class="relative z-[1] pb-24 px-6">
      <div class="max-w-4xl mx-auto">
        {posts.length === 0 ? (
          <div class="text-center py-16">
            <p class="text-(--color-text-muted) text-lg">Próximamente publicaremos nuestro primer artículo. ¡Vuelve pronto!</p>
          </div>
        ) : (
          <div class="flex flex-col gap-6">
            {posts.map((post, i) => (
              <a
                href={`/blog/${post.id}`}
                class:list={[
                  "group block bg-(--color-card) border border-(--color-border-subtle) rounded-2xl p-8 no-underline transition-all duration-400",
                  "hover:border-(--color-border-accent) hover:-translate-y-1 hover:shadow-[0_20px_60px_rgba(0,0,0,0.3)]",
                  "reveal",
                  `reveal-delay-${(i % 3) + 1}`,
                ]}
              >
                <!-- Date & Tags -->
                <div class="flex items-center gap-3 mb-4 flex-wrap">
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="text-xs text-(--color-text-muted)"
                  >
                    {post.data.pubDate.toLocaleDateString("es-CL", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                  {post.data.tags.map((tag: string) => (
                    <span class="px-2 py-0.5 rounded text-xs text-(--color-purple-400) border border-(--color-border-accent)" style="background: rgba(168, 85, 247, 0.1);">
                      {tag}
                    </span>
                  ))}
                </div>

                <h2 class="text-xl font-bold mb-2 group-hover:text-(--color-purple-400) transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-sm text-(--color-text-secondary) leading-relaxed">
                  {post.data.description}
                </p>

                <div class="mt-4 text-sm text-(--color-purple-400) font-medium">
                  Leer artículo →
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
