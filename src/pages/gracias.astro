---
// src/pages/gracias.astro
// Página de confirmación del form de Contact (Web3Forms redirige acá).
// Es la ÚNICA responsable de disparar `form_conversion` en el dataLayer:
// GTM (cuando se instale el contenedor) escucha ese Custom Event como
// trigger de conversión. El form NO dispara eventos por sí mismo.
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/layout/Navbar.astro";
import Footer from "@components/layout/Footer.astro";
import { siteConfig } from "@/config/site";
---

<Layout
  title="Gracias por tu mensaje"
  description="Recibimos tu mensaje. Te responderemos a la brevedad."
  noindex={true}
>
  <Navbar />
  <main>
    <section class="relative z-[1] min-h-[70vh] flex items-center justify-center pt-36 pb-20 px-6">
      <div class="max-w-2xl mx-auto text-center">
        <div class="w-16 h-16 rounded-full grid place-items-center mx-auto mb-8 border border-(--color-border-accent) bg-accent/10 text-accent">
          <svg viewBox="0 0 24 24" class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </div>

        <h1 class="text-[clamp(2rem,5vw,3.4rem)] font-bold leading-tight tracking-tight mb-5">
          ¡Gracias! Recibimos <span class="gradient-text">tu mensaje</span>
        </h1>

        <p class="text-lg text-(--color-text-secondary) leading-relaxed max-w-xl mx-auto mb-10">
          Te responderemos a la brevedad, normalmente dentro del mismo día hábil.
          Si es urgente, escríbenos directo a {siteConfig.email}.
        </p>

        <div class="flex gap-4 items-center justify-center flex-wrap">
          <a
            href="/"
            class="inline-block px-7 py-3.5 rounded-lg text-sm font-semibold text-stone-900 no-underline transition-all duration-300 bg-accent hover:bg-accent-hover hover:-translate-y-0.5 hover:shadow-[0_10px_30px_var(--color-accent-glow-strong)]"
          >
            Volver al inicio
          </a>
          <a
            href="/#casos"
            class="inline-block px-7 py-3.5 rounded-lg text-sm font-semibold text-(--color-text-primary) no-underline border border-(--color-border-subtle) transition-all duration-300 hover:border-(--color-border-accent) hover:text-accent-light"
          >
            Ver casos de éxito →
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <!-- Conversión: Custom Event para GTM. Inline para que se empuje aunque
       el contenedor GTM cargue después (o aún no esté instalado). -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: "form_conversion" });
  </script>
</Layout>
