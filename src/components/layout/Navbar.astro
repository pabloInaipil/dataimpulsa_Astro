---
// src/components/layout/Navbar.astro
interface Props {
  activeLink?: string;
}

const { activeLink = "inicio" } = Astro.props;

const navLinks = [
  { href: "/", label: "Inicio", id: "inicio" },
  { href: "/nosotros", label: "Nosotros", id: "nosotros" },
  { href: "/portafolio", label: "Portafolio", id: "portafolio" },
  { href: "/blog", label: "Blog", id: "blog" },
];
---

<nav
  class="fixed top-0 left-0 right-0 z-50 px-4 py-3 md:px-6 md:py-5 bg-[--color-deep]/80 backdrop-blur-xl border-b border-[--color-border-subtle] transition-all duration-300"
  id="main-nav"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Logo -->

 <a href="/" class="flex items-center gap-2 no-underline">
  <img src="/images/logo/dark.png" alt="DatAImpulsa" class="h-10 md:h-16 w-auto block light:hidden" />
  <img src="/images/logo/light.png" alt="DatAImpulsa" class="h-10 md:h-16 w-auto hidden light:block" />
</a>

    <!-- Desktop Links -->
    <ul class="hidden md:flex items-center gap-8 list-none">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "text-sm font-medium transition-colors duration-200 no-underline",
              activeLink === link.id
                ? "text-[--color-purple-400]"
                : "text-[--color-text-secondary] hover:text-[--color-text-primary]",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/#contacto"
          class="inline-block px-5 py-2.5 rounded-lg text-sm font-semibold text-white no-underline transition-all duration-300 hover:-translate-y-0.5"
          style="background: linear-gradient(135deg, var(--color-purple-600), var(--color-purple-700));"
        >
          Contáctanos
        </a>
      </li>
    </ul>
    <!-- Theme Toggle -->
    <button
      id="theme-toggle"
      class="w-9 h-9 rounded-lg flex items-center justify-center border border-[--color-border-subtle] bg-transparent cursor-pointer transition-all duration-300 hover:border-[--color-border-accent] text-[--color-text-secondary] hover:text-[--color-purple-400]"
      aria-label="Cambiar tema"
    >
      <span id="icon-dark" class="text-sm hidden">🌙</span>
      <span id="icon-light" class="text-sm hidden">☀️</span>
    </button>

    <!-- Mobile Hamburger -->
    <button
      class="md:hidden flex flex-col gap-1.5 p-2 bg-transparent border-none cursor-pointer"
      id="mobile-toggle"
      aria-label="Abrir menú"
    >
      <span class="block w-6 h-0.5 bg-[--color-text-primary] transition-all duration-300 origin-center" id="bar-1"></span>
      <span class="block w-6 h-0.5 bg-[--color-text-primary] transition-all duration-300" id="bar-2"></span>
      <span class="block w-6 h-0.5 bg-[--color-text-primary] transition-all duration-300 origin-center" id="bar-3"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    class="md:hidden max-h-0 overflow-hidden transition-all duration-500 ease-in-out"
    id="mobile-menu"
  >
    <ul class="flex flex-col gap-4 pt-6 pb-4 list-none">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "block text-base font-medium no-underline transition-colors",
              activeLink === link.id
                ? "text-[--color-purple-400]"
                : "text-[--color-text-secondary] hover:text-[--color-text-primary]",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/#contacto"
          class="inline-block px-5 py-2.5 rounded-lg text-sm font-semibold text-white no-underline mt-2"
          style="background: linear-gradient(135deg, var(--color-purple-600), var(--color-purple-700));"
        >
          Contáctanos
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");
  const bar1 = document.getElementById("bar-1");
  const bar2 = document.getElementById("bar-2");
  const bar3 = document.getElementById("bar-3");
  let isOpen = false;

  toggle?.addEventListener("click", () => {
    isOpen = !isOpen;
    if (menu) {
      menu.style.maxHeight = isOpen ? `${menu.scrollHeight}px` : "0";
    }
    bar1?.classList.toggle("rotate-45", isOpen);
    bar1?.classList.toggle("translate-y-[4px]", isOpen);
    bar2?.classList.toggle("opacity-0", isOpen);
    bar3?.classList.toggle("-rotate-45", isOpen);
    bar3?.classList.toggle("-translate-y-[4px]", isOpen);
  });
</script>
