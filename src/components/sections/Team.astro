---
// src/components/sections/Team.astro
import { Icon } from "astro-icon/components";

interface TeamMember {
  name: string;
  role: string;
  skills: string;
  photo?: string;
  linkedin: string;
  twitter?: string;
}

// Equipo en orden original (para móvil)
const team: TeamMember[] = [
  {
    name: "Nadia Silva",
    role: "Ingeniera Comercial / Administrador Público",
    skills: "Asesora Comercial",
    linkedin: "https://www.linkedin.com/in/",
    photo: "/images/team/Nadia.jpeg"
  },
  {
    name: "Pablo Inaipil",
    role: "Analista Desarrollador Power BI",
    skills: "Power BI · SQL · Power Query · DAX · Python",
    linkedin: "https://www.linkedin.com/in/pablo-inaipil/",
    photo: "/images/team/pablo2024.jpg"
  },
  {
    name: "Juan Osses",
    role: "Python Developer",
    skills: "FullStack Dev · Python · Java · Astro · SQL · JavaScript · React · Node.js · GitHub",
    linkedin: "https://www.linkedin.com/in/jnlsosses/",
    photo: "/images/team/john.jpg"
  },
  {
    name: "Luis Bernales",
    role: "Ingeniero Docente Analista BI",
    skills: "Análisis de Datos · Power BI · SQL · Excel Avanzado · DAX · Python",
    linkedin: "https://www.linkedin.com/in/luisbernalesanalista/",
    photo: "/images/team/Gerard.jpeg"
  },
  {
    name: "Corina Rivera",
    role: "Analista Remuneraciones Senior/UX-UI Designer",
    skills: "UX-UI Design · Analista de RRHH · Comunicación · Excel Avanzado",
    linkedin: "https://www.linkedin.com/in/corinarivera/",
    photo: "/images/team/cori.png"
  },
];

// Orden específico para desktop
const desktopOrder = ["Luis Bernales", "Corina Rivera", "Pablo Inaipil", "Nadia Silva", "Juan Osses"];

// Crear un array con el orden de desktop
const desktopTeam = desktopOrder.map(name => 
  team.find(member => member.name === name)
).filter((member): member is TeamMember => member !== undefined);
---

<section id="equipo" class="relative z-[1] py-24 px-6">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-16 reveal">
      <div class="text-xs font-medium tracking-widest uppercase text-(--color-purple-400) mb-3 font-display">
        // Equipo
      </div>
      <h2 class="text-[clamp(2rem,3.5vw,2.8rem)] font-bold tracking-tight mb-4">
        Las personas detrás de los datos
      </h2>
      <p class="text-lg text-(--color-text-secondary) max-w-xl leading-relaxed">
        Profesionales especializados en transformar complejidad en claridad.
      </p>
    </div>

    <!-- Grid único que muestra diferente orden según el dispositivo -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
      <!-- En móvil: mostrar en orden original (team) -->
      {team.map((member, i) => (
        <div
          class:list={[
            "bg-(--color-card) border border-(--color-border-subtle) rounded-2xl overflow-hidden transition-all duration-400",
            "hover:border-(--color-border-accent) hover:-translate-y-1.5 hover:shadow-[0_20px_60px_rgba(0,0,0,0.3)]",
            "reveal",
            `reveal-delay-${i + 1}`,
            // En mobile y tablet: mostrar en el orden original
            // En desktop: ocultar estos (se mostrarán en el orden personalizado)
            "lg:hidden",
          ]}
        >
          <!-- Photo -->
          <div
            class="w-full aspect-square flex items-center justify-center text-5xl text-(--color-text-muted) relative overflow-hidden"
            style="background: linear-gradient(135deg, #1a1a3e, #2a1a4e);"
          >
            {member.photo ? (
              <img 
                src={member.photo} 
                alt={member.name} 
                class="w-full h-full object-cover" 
                loading="lazy" 
                width="400" 
                height="400"
              />
            ) : (
              <Icon name="lucide:user" class="w-16 h-16" aria-hidden="true" />
            )}
            {member.photo && (
              <div class="absolute bottom-0 left-0 right-0 h-1/2" style="background: linear-gradient(to top, var(--color-card), transparent);"></div>
            )}
          </div>

          <!-- Info -->
          <div class="p-5">
            <h4 class="text-base font-semibold mb-1">{member.name}</h4>
            <div class="text-xs text-(--color-purple-400) mb-2 font-display">
              {member.role}
            </div>
            <div class="text-xs text-(--color-text-muted) leading-relaxed mb-3">
              {member.skills}
            </div>
            <div class="flex gap-3">
              {member.twitter && (
                <a
                  href={member.twitter}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-(--color-text-muted) no-underline hover:text-(--color-purple-400) transition-colors"
                  aria-label={`${member.name} en X`}
                >
                  <Icon name="lucide:twitter" class="w-4 h-4" />
                </a>
              )}
              <a
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-(--color-text-muted) no-underline hover:text-(--color-purple-400) transition-colors"
                aria-label={`${member.name} en LinkedIn`}
              >
                LinkedIn
              </a>
            </div>
          </div>
        </div>
      ))}

      <!-- En desktop: mostrar en orden personalizado (Luis, Corina, Pablo, Nadia, Juan) -->
      {desktopTeam.map((member, i) => (
        <div
          class:list={[
            "bg-(--color-card) border border-(--color-border-subtle) rounded-2xl overflow-hidden transition-all duration-400",
            "hover:border-(--color-border-accent) hover:-translate-y-1.5 hover:shadow-[0_20px_60px_rgba(0,0,0,0.3)]",
            "reveal",
            `reveal-delay-${i + 1}`,
            // En desktop: mostrar con el orden personalizado
            // En móvil: ocultar estos (se muestran los del orden original)
            "hidden lg:block",
          ]}
        >
          <!-- Photo -->
          <div
            class="w-full aspect-square flex items-center justify-center text-5xl text-(--color-text-muted) relative overflow-hidden"
            style="background: linear-gradient(135deg, #1a1a3e, #2a1a4e);"
          >
            {member.photo ? (
              <img 
                src={member.photo} 
                alt={member.name} 
                class="w-full h-full object-cover" 
                loading="lazy" 
                width="400" 
                height="400"
              />
            ) : (
              <Icon name="lucide:user" class="w-16 h-16" aria-hidden="true" />
            )}
            {member.photo && (
              <div class="absolute bottom-0 left-0 right-0 h-1/2" style="background: linear-gradient(to top, var(--color-card), transparent);"></div>
            )}
          </div>

          <!-- Info -->
          <div class="p-5">
            <h4 class="text-base font-semibold mb-1">{member.name}</h4>
            <div class="text-xs text-(--color-purple-400) mb-2 font-display">
              {member.role}
            </div>
            <div class="text-xs text-(--color-text-muted) leading-relaxed mb-3">
              {member.skills}
            </div>
            <div class="flex gap-3">
              {member.twitter && (
                <a
                  href={member.twitter}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-(--color-text-muted) no-underline hover:text-(--color-purple-400) transition-colors"
                  aria-label={`${member.name} en X`}
                >
                  <Icon name="lucide:twitter" class="w-4 h-4" />
                </a>
              )}
              <a
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-(--color-text-muted) no-underline hover:text-(--color-purple-400) transition-colors"
                aria-label={`${member.name} en LinkedIn`}
              >
                LinkedIn
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>