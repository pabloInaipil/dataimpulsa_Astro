---
// src/components/sections/StatsBar.astro
// Panel de métricas tipo dashboard: PageSpeed, tiempo de carga y Core Web Vitals.
// Los números cuentan de 0 a su valor al entrar en viewport (una sola vez);
// el SSR shipea los valores finales y el JS los lee de data-count.
import { Icon } from "astro-icon/components";

const vitals = [
  { name: "LCP", value: "0.6", dec: 1, suffix: "s", sr: "0.6 segundos", wide: false },
  { name: "INP", value: "48", dec: 0, suffix: "ms", sr: "48 milisegundos", wide: true },
  { name: "CLS", value: "0.01", dec: 2, suffix: "", sr: "0.01", wide: false },
];

const months = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul"];
const sparkY = [68, 60, 52, 58, 42, 34, 18];
---

<section class="relative z-[1] py-10 px-6" data-stats-bar>
  <h2 class="sr-only">Resultados de rendimiento web</h2>
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Card 1: Rendimiento promedio -->
    <div class="bg-(--color-card) border border-(--color-border-subtle) rounded-2xl p-7 reveal reveal-delay-1">
      <div class="text-[0.65rem] font-display tracking-widest uppercase text-(--color-text-muted) mb-5">
        Rendimiento promedio
      </div>
      <div class="flex items-center justify-between gap-4">
        <div>
          <div class="flex items-baseline gap-1">
            <span class="sr-only">98 de 100</span>
            <span class="text-5xl font-bold font-display tabular-nums count-int-2" data-count="98" aria-hidden="true">98</span>
            <span class="text-xl font-semibold text-(--color-text-muted) font-display" aria-hidden="true">/100</span>
          </div>
          <div class="text-sm text-(--color-text-muted) mt-2">Google PageSpeed</div>
        </div>
        <div class="score-ring w-20 h-20 rounded-full grid place-items-center shrink-0" data-ring="98">
          <div class="w-[60px] h-[60px] rounded-full bg-(--color-card) grid place-items-center text-accent">
            <Icon name="lucide:zap" class="w-6 h-6" aria-hidden="true" />
          </div>
        </div>
      </div>
    </div>

    <!-- Card 2: Tiempo de carga -->
    <div class="bg-(--color-card) border border-(--color-border-subtle) rounded-2xl p-7 reveal reveal-delay-2">
      <div class="text-[0.65rem] font-display tracking-widest uppercase text-(--color-text-muted) mb-5">
        Tiempo de carga
      </div>
      <div class="flex items-center gap-3 mb-4">
        <span class="text-4xl font-bold font-display"><span class="sr-only">0.6 segundos</span><span class="tabular-nums" data-count="0.6" data-dec="1" aria-hidden="true">0.6</span><span aria-hidden="true">s</span></span>
        <span class="text-[0.65rem] font-display font-semibold px-2.5 py-1 rounded-full text-green-500 bg-green-500/10 border border-green-500/20">
          ULTRA RÁPIDO
        </span>
      </div>
      <div class="relative" data-spark>
        <svg viewBox="0 0 280 80" class="w-full h-auto" aria-hidden="true">
          <polygon
            class="spark-area"
            points="20,68 60,60 100,52 140,58 180,42 220,34 260,18 260,80 20,80"
          ></polygon>
          <polyline
            class="spark-line"
            points="20,68 60,60 100,52 140,58 180,42 220,34 260,18"
          ></polyline>
          {sparkY.map((y, i) => (
            <circle class="spark-dot" cx={20 + i * 40} cy={y} r="3" data-month={months[i]}></circle>
          ))}
        </svg>
        <div
          class="spark-tip absolute top-0 left-0 pointer-events-none font-display text-[0.6rem] font-semibold px-2 py-0.5 rounded-md bg-(--color-card-hover) border border-(--color-border-subtle) text-(--color-text-secondary)"
          aria-hidden="true"
        ></div>
      </div>
      <div class="flex justify-between text-[0.6rem] font-display text-(--color-text-muted) mt-1 px-1">
        {months.map((m) => <span>{m}</span>)}
      </div>
    </div>

    <!-- Card 3: Core Web Vitals -->
    <div class="bg-(--color-card) border border-(--color-border-subtle) rounded-2xl p-7 reveal reveal-delay-3">
      <div class="text-[0.65rem] font-display tracking-widest uppercase text-(--color-text-muted) mb-5">
        Core Web Vitals
      </div>
      <ul class="flex flex-col gap-4 list-none">
        {vitals.map((v) => (
          <li class="flex items-center justify-between gap-3">
            <span class="text-sm font-display font-semibold text-(--color-text-secondary)">{v.name}</span>
            <span class="text-sm font-display font-bold ml-auto"><span class="sr-only">{v.sr}</span><span class:list={["tabular-nums", v.wide && "count-int-2"]} data-count={v.value} data-dec={v.dec} aria-hidden="true">{v.value}</span>{v.suffix && <span aria-hidden="true">{v.suffix}</span>}</span>
            <span class="text-[0.6rem] font-display px-2 py-0.5 rounded-full text-green-500 bg-green-500/10 border border-green-500/20">
              Excelente
            </span>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>

<style>
  /* El fallback 98 del var() garantiza ring completo sin JS y con reduced-motion */
  .score-ring {
    background-image: conic-gradient(
      #22c55e calc(var(--ring, 98) * 1%),
      var(--color-card-hover) 0
    );
  }

  /* Ancho reservado para enteros que crecen de 1 a 2 dígitos durante el conteo:
     con tabular-nums cada dígito mide 1ch, así el layout no se mueve ni un px */
  .count-int-2 {
    display: inline-block;
    min-width: 2ch;
    text-align: right;
  }

  .spark-line {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .spark-area {
    fill: var(--color-accent-glow);
  }

  .spark-dot {
    fill: var(--color-accent-light);
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.15s ease;
  }

  .spark-dot.is-active {
    transform: scale(1.7);
  }

  .spark-tip {
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  [data-spark].spark-hover .spark-tip {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .spark-dot,
    .spark-tip {
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector("[data-stats-bar]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ===== Count-up on scroll (una sola vez) =====
  // Con reduced-motion no se toca nada: quedan los valores finales del SSR.
  if (section && !reduced) {
    const targets = [...section.querySelectorAll<HTMLElement>("[data-count]")].map((el) => ({
      el,
      to: parseFloat(el.dataset.count ?? "0"),
      dec: parseInt(el.dataset.dec ?? "0", 10),
    }));
    const ring = section.querySelector<HTMLElement>("[data-ring]");
    const ringTo = ring ? parseFloat(ring.dataset.ring ?? "0") : 0;

    for (const t of targets) t.el.textContent = (0).toFixed(t.dec);
    ring?.style.setProperty("--ring", "0");

    const DURATION = 1400;
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        let start: number | undefined;
        const tick = (now: number) => {
          if (start === undefined) start = now;
          const p = easeOutCubic(Math.min((now - start) / DURATION, 1));
          for (const t of targets) t.el.textContent = (t.to * p).toFixed(t.dec);
          ring?.style.setProperty("--ring", String(ringTo * p));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      },
      { threshold: 0.3 }
    );
    io.observe(section);
  }

  // ===== Sparkline hover (solo dispositivos con puntero fino: en touch queda estático) =====
  const wrap = section?.querySelector<HTMLElement>("[data-spark]");
  if (wrap && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    const svg = wrap.querySelector("svg");
    const tip = wrap.querySelector<HTMLElement>(".spark-tip");
    const dots = svg ? [...svg.querySelectorAll<SVGCircleElement>(".spark-dot")] : [];

    if (svg && tip && dots.length) {
      const VIEW_W = 280;
      const VIEW_H = 80;
      let pointerX = 0;
      let rafId = 0;
      let active = -1;

      const update = () => {
        rafId = 0;
        const rect = svg.getBoundingClientRect();
        const x = ((pointerX - rect.left) / rect.width) * VIEW_W;
        let best = 0;
        let bestDist = Infinity;
        dots.forEach((d, i) => {
          const dist = Math.abs(x - Number(d.getAttribute("cx")));
          if (dist < bestDist) {
            bestDist = dist;
            best = i;
          }
        });
        if (best === active) return;
        if (active >= 0) dots[active].classList.remove("is-active");
        active = best;
        const dot = dots[best];
        dot.classList.add("is-active");
        tip.textContent = dot.dataset.month ?? "";
        const px = (Number(dot.getAttribute("cx")) / VIEW_W) * rect.width;
        const py = (Number(dot.getAttribute("cy")) / VIEW_H) * rect.height;
        tip.style.transform = `translate(${px}px, ${py}px) translate(-50%, -130%)`;
      };

      svg.addEventListener("pointermove", (e) => {
        pointerX = e.clientX;
        if (!rafId) rafId = requestAnimationFrame(update);
      });
      svg.addEventListener("pointerenter", () => wrap.classList.add("spark-hover"));
      svg.addEventListener("pointerleave", () => {
        wrap.classList.remove("spark-hover");
        if (active >= 0) dots[active].classList.remove("is-active");
        active = -1;
      });
    }
  }
</script>
