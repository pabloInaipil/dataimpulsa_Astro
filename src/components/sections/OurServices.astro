---
// src/components/sections/Services.astro
import { Icon } from "astro-icon/components";

const services = [
  {
    title: "Desarrollo Web Astro",
    description: "Sitios rápidos, seguros y optimizados para SEO. Experiencia moderna que convierte.",
    icon: "lucide:code-xml",
    href: "/#servicios",
  },
  {
    title: "Dashboards Power BI",
    description: "Transformamos tus datos en insights claros para decisiones más inteligentes.",
    icon: "lucide:bar-chart-3",
    href: "/#servicios",
  },
  {
    title: "Automatización RPA + IA",
    description: "Automatizamos procesos repetitivos para que tu equipo se enfoque en lo que importa.",
    icon: "lucide:bot",
    href: "/#servicios",
  },
];

const metrics = [
  {
    value: "98/100",
    label: "PageSpeed Insights",
    sub: "Puntuación promedio en dispositivos móviles",
    icon: "lucide:gauge",
  },
  {
    value: "0.6s",
    label: "Tiempo de carga promedio",
    sub: "Sitios ligeros y optimizados",
    icon: "lucide:clock",
  },
  {
    value: "99.9%",
    label: "Disponibilidad",
    sub: "Infraestructura confiable y segura.",
    icon: "lucide:shield-check",
  },
  {
    value: "+35%",
    label: "Crecimiento promedio",
    sub: "Resultados reales para nuestros clientes.",
    icon: "lucide:trending-up",
  },
];

const logos = ["FALABELLA", "copec", "bci", "andesite", "chile"];
---

<section id="servicios" class="relative z-[1] py-20 px-4 sm:px-6 bg-(--color-deep)">
  <div class="max-w-6xl mx-auto">

    <!-- Encabezado -->
    <div class="text-center mb-12">
      <p class="text-accent text-xs font-semibold tracking-widest uppercase mb-3 font-display">
        Nuestros Servicios
      </p>
      <h2 class="text-3xl md:text-4xl font-bold text-(--color-text-primary) mb-3 font-display">
        Soluciones digitales que generan impacto
      </h2>
      <p class="text-(--color-text-secondary) text-base md:text-lg max-w-2xl mx-auto">
        Combinamos estrategia, diseño, datos e inteligencia artificial para transformar tu operación y acelerar resultados.
      </p>
    </div>

    <!-- 3 Tarjetas de servicios -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-6">
      {services.map((s) => (
        <div class="bg-(--color-card) border border-(--color-border-subtle) rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-(--color-border-accent) transition-all duration-300">
          <div class="w-11 h-11 rounded-xl bg-accent/10 flex items-center justify-center mb-4 text-accent">
            <Icon name={s.icon} class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-semibold text-(--color-text-primary) mb-2 font-display">
            {s.title}
          </h3>
          <p class="text-sm text-(--color-text-secondary) leading-relaxed mb-4">
            {s.description}
          </p>
          <a
            href={s.href}
            class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:text-accent-hover no-underline transition-colors"
          >
            Saber más
            <Icon name="lucide:arrow-right" class="w-4 h-4" />
          </a>
        </div>
      ))}
    </div>

    <!-- Barra de métricas -->
    <div class="bg-(--color-surface) border border-(--color-border-subtle) rounded-2xl p-6 md:p-8 mb-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-4">
        {metrics.map((m) => (
          <div class="flex items-start gap-3">
            <div class="w-9 h-9 rounded-lg bg-(--color-card) border border-(--color-border-subtle) flex items-center justify-center shrink-0 text-accent">
              <Icon name={m.icon} class="w-4 h-4" />
            </div>
            <div>
              <p class="text-2xl md:text-3xl font-bold text-(--color-text-primary) font-display leading-none mb-1">
                {m.value}
              </p>
              <p class="text-sm font-medium text-(--color-text-primary)">
                {m.label}
              </p>
              <p class="text-xs text-(--color-text-muted) mt-0.5 leading-snug">
                {m.sub}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Logos de confianza -->
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
      <span class="text-xs text-(--color-text-muted)">
        Confían en nosotros empresas que quieren crecer sin límites
      </span>
      {logos.map((logo) => (
        <span class="text-sm font-semibold text-(--color-text-muted) tracking-wide uppercase">
          {logo}
        </span>
      ))}
    </div>

  </div>
</section>