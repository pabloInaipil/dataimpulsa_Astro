---
// src/components/sections/Testimonials.astro

interface Testimonial {
  name: string;
  role: string;
  company: string;
  image: string;
  rating: number;
  quote: string;
}

// ============================================================
// TESTIMONIOS — Agregar hasta 6. Solo editar este array.
// Imágenes en /public/images/testimonials/ (400×300 WebP ideal)
// ============================================================
const testimonials: Testimonial[] = [
  {
    name: "Miguel González",
    role: "Gerente General",
    company: "MGI Estructuras Metálicas",
    image: "/images/testimonials/mgi.webp",
    rating: 5,
    quote:
      "En menos de una semana teníamos nuestro sitio web en línea, profesional y rápido. El equipo de DatAImpulsa entendió exactamente lo que necesitábamos.",
  },
  {
    name: "Alex Norambuena",
    role: "Propietario",
    company: "TodoCasa Construcciones",
    image: "/images/testimonials/todocasa.webp",
    rating: 5,
    quote:
      "Desde que lanzamos la landing page, recibimos cotizaciones todos los días. La inversión se pagó sola el primer mes.",
  },
  // ——— Agregar más testimonios aquí (hasta 6) ———
  // {
  //   name: "Nombre Cliente",
  //   role: "Cargo",
  //   company: "Empresa",
  //   image: "/images/testimonials/empresa.webp",
  //   rating: 5,
  //   quote: "Testimonio del cliente...",
  // },
];

const totalSlides = testimonials.length;
---

<section id="testimonios" class="relative z-[1] py-24 px-6 bg-(--color-surface)">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-16 reveal">
      <div
        class="text-xs font-medium tracking-widest uppercase text-(--color-purple-400) mb-3"
        style="font-family: var(--font-mono);"
      >
        // Testimonios
      </div>
      <h2 class="text-[clamp(2rem,3.5vw,2.8rem)] font-bold tracking-tight mb-4">
        Lo que dicen nuestros clientes
      </h2>
      <p class="text-lg text-(--color-text-secondary) max-w-xl leading-relaxed">
        Resultados reales de PYMEs que confiaron en nosotros.
      </p>
    </div>

    <!-- Carousel Wrapper -->
    <div class="relative overflow-hidden reveal max-w-4xl mx-auto" id="testimonial-carousel">
      <div
        class="testimonial-track flex transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
        id="testimonial-track"
      >
        {testimonials.map((t, i) => (
          <div
            class="testimonial-slide flex-shrink-0 w-full md:w-1/2 px-3"
            data-index={i}
          >
            <div
              class="h-full bg-(--color-card) border border-(--color-border-subtle) rounded-2xl overflow-hidden transition-all duration-400 hover:border-(--color-border-accent) hover:shadow-[0_20px_60px_rgba(0,0,0,0.3)]"
            >
              <!-- Business Photo -->
              <div class="relative w-full aspect-[3/2] overflow-hidden">
                <img
                  src={t.image}
                  alt={`Proyecto ${t.company}`}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover"
                />
                <!-- Rating badge -->
                <div
                  class="absolute top-4 right-4 flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold border border-(--color-border-accent)"
                  style="background: rgba(17, 17, 40, 0.85); backdrop-filter: blur(8px);"
                >
                  <span class="text-amber-400">★</span>
                  <span class="text-(--color-text-primary)">{t.rating.toFixed(1)}</span>
                </div>
              </div>

              <!-- Content -->
              <div class="p-5">
                <!-- Stars -->
                <div class="flex gap-0.5 mb-4">
                  {Array.from({ length: 5 }).map((_, s) => (
                    <svg
                      class={`w-4 h-4 ${s < t.rating ? 'text-amber-400' : 'text-(--color-text-muted)'}`}
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>

                <!-- Quote -->
                <blockquote class="text-sm text-(--color-text-secondary) leading-relaxed mb-5 italic">
                  "{t.quote}"
                </blockquote>

                <!-- Author -->
                <div class="border-t border-(--color-border-subtle) pt-4">
                  <p class="text-sm font-semibold text-(--color-text-primary)">{t.name}</p>
                  <p class="text-xs text-(--color-text-muted)">
                    {t.role} — <span class="text-(--color-purple-400)">{t.company}</span>
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Navigation Arrows -->
      {totalSlides > 2 && (
        <>
          <button
            type="button"
            id="test-prev"
            class="absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-(--color-card) border border-(--color-border-accent) flex items-center justify-center text-(--color-purple-400) transition-all hover:bg-(--color-card-hover) hover:scale-110 shadow-lg"
            aria-label="Testimonio anterior"
          >
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            type="button"
            id="test-next"
            class="absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-(--color-card) border border-(--color-border-accent) flex items-center justify-center text-(--color-purple-400) transition-all hover:bg-(--color-card-hover) hover:scale-110 shadow-lg"
            aria-label="Testimonio siguiente"
          >
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </>
      )}

      <!-- Dots -->
      <div class="flex justify-center gap-2 mt-8" id="testimonial-dots">
        {testimonials.map((_, i) => (
          <button
            type="button"
            class={`w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-(--color-purple-500) w-6' : 'bg-(--color-text-muted)'}`}
            data-dot={i}
            aria-label={`Ir al testimonio ${i + 1}`}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('testimonial-track') as HTMLElement;
  const dots = document.querySelectorAll<HTMLButtonElement>('[data-dot]');
  const prevBtn = document.getElementById('test-prev');
  const nextBtn = document.getElementById('test-next');
  const slides = document.querySelectorAll<HTMLElement>('.testimonial-slide');
  const total = slides.length;

  let current = 0;
  let autoTimer: ReturnType<typeof setInterval>;
  const INTERVAL = 6000;

  function isMobile() {
    return window.innerWidth < 768;
  }

  function maxIndex() {
    // On desktop we show 2, so max scroll is total - 2
    // On mobile we show 1, so max scroll is total - 1
    return Math.max(0, total - (isMobile() ? 1 : 2));
  }

  function goTo(index: number) {
    if (index < 0) index = maxIndex();
    if (index > maxIndex()) index = 0;
    current = index;

    const slideWidth = isMobile() ? 100 : 50; // percent
    track.style.transform = `translateX(-${current * slideWidth}%)`;

    dots.forEach((dot, i) => {
      const isActive = i === current;
      dot.classList.toggle('w-6', isActive);
      dot.classList.toggle('w-2', !isActive);
      dot.style.background = isActive
        ? 'var(--color-purple-500)'
        : 'var(--color-text-muted)';
    });
  }

  function next() { goTo(current + 1); }
  function prev() { goTo(current - 1); }

  function startAuto() {
    stopAuto();
    autoTimer = setInterval(next, INTERVAL);
  }
  function stopAuto() {
    if (autoTimer) clearInterval(autoTimer);
  }

  prevBtn?.addEventListener('click', () => { prev(); startAuto(); });
  nextBtn?.addEventListener('click', () => { next(); startAuto(); });
  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      goTo(Number(dot.dataset.dot));
      startAuto();
    });
  });

  // Pause on hover
  const carousel = document.getElementById('testimonial-carousel');
  carousel?.addEventListener('mouseenter', stopAuto);
  carousel?.addEventListener('mouseleave', startAuto);

  // Touch swipe
  let touchStartX = 0;
  carousel?.addEventListener('touchstart', (e) => {
    touchStartX = (e as TouchEvent).touches[0].clientX;
    stopAuto();
  }, { passive: true });
  carousel?.addEventListener('touchend', (e) => {
    const diff = touchStartX - (e as TouchEvent).changedTouches[0].clientX;
    if (Math.abs(diff) > 50) diff > 0 ? next() : prev();
    startAuto();
  }, { passive: true });

  // Recalc on resize
  window.addEventListener('resize', () => {
    if (current > maxIndex()) current = maxIndex();
    goTo(current);
  });

  // Init
  startAuto();
</script>