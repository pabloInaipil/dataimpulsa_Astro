---
// Bloque de beneficios centrados con animación touch/hover
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Ultra rápido",
    description: "Páginas que cargan al instante.",
    icon: "lucide:zap",
  },
  {
    title: "SEO nativo",
    description: "Mejor posicionamiento desde el código.",
    icon: "lucide:search",
  },
  {
    title: "Arquitectura moderna",
    description: "Jamstack, escalable y segura.",
    icon: "lucide:layers",
  },
  {
    title: "Experiencia increíble",
    description: "Interfaces fluidas y sin distracciones.",
    icon: "lucide:sparkles",
  },
  {
    title: "100% a medida",
    description: "Diseñado para tu negocio.",
    icon: "lucide:target",
  },
];
---

<section class="relative z-[1] py-16 px-4 sm:px-6 bg-(--color-surface)/40 border-y border-(--color-border-subtle)">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 md:gap-4 justify-items-center text-center">
      {features.map((f, i) => (
        <div
          class={`feature-card group flex flex-col items-center text-center max-w-[160px] reveal reveal-delay-${(i % 4) + 1}`}
        >
          <!-- Icono -->
          <div class="feature-icon w-14 h-14 rounded-full bg-accent/10 border border-(--color-border-accent) flex items-center justify-center mb-4 text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-white group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-blue-500/25 group-active:scale-95">
            <Icon name={f.icon} class="w-6 h-6" />
          </div>

          <h3 class="text-sm md:text-base font-semibold text-(--color-text-primary) mb-1 font-display">
            {f.title}
          </h3>
          <p class="text-xs md:text-sm text-(--color-text-secondary) leading-relaxed">
            {f.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-card {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .feature-card:hover,
  .feature-card:active {
    transform: translateY(-6px);
  }

  /* Toque en móvil */
  .feature-card:active .feature-icon {
    transform: scale(0.92);
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card,
    .feature-icon {
      transition: none !important;
    }
    .feature-card:hover {
      transform: none !important;
    }
  }
</style>