---
// src/components/sections/Services.astro
// Features de la línea principal: desarrollo web con Astro.
const features = [
  {
    title: "Ultra rápido",
    description: "Páginas que cargan al instante.",
    icon: "M13 2 3 14h7l-1 8 10-12h-7l1-8z",
  },
  {
    title: "SEO nativo",
    description: "Mejor posicionamiento desde el código.",
    icon: "M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm10 2-4.35-4.35",
  },
  {
    title: "Arquitectura moderna",
    description: "Jamstack, escalable y segura.",
    icon: "M12 2 2 7l10 5 10-5-10-5ZM2 12l10 5 10-5M2 17l10 5 10-5",
  },
  {
    title: "Experiencia increíble",
    description: "Interfaces fluidas y sin distracciones.",
    icon: "M12 3v2m6.4.6-1.5 1.5M21 12h-2M5.1 5.6l1.5 1.5M3 12h2m2.6 6.4 1.5-1.5m5.8 0 1.5 1.5M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z",
  },
  {
    title: "100% a medida",
    description: "Diseñado para tu negocio.",
    icon: "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 4a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z",
  },
];
---

<section id="servicios" class="relative z-[1] py-16 px-6 border-t border-b border-[--color-border-subtle] bg-[--color-surface]/50">
  <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8">
    {features.map((f, i) => (
      <div class:list={["flex items-start gap-4 lg:flex-col lg:gap-0 reveal", `reveal-delay-${(i % 4) + 1}`]}>
        <div class="w-12 h-12 rounded-full grid place-items-center shrink-0 border border-[--color-border-accent] bg-accent/10 text-accent lg:mb-4">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={f.icon}></path>
          </svg>
        </div>
        <div>
          <h3 class="text-base font-semibold mb-1">{f.title}</h3>
          <p class="text-sm text-[--color-text-secondary] leading-relaxed">{f.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
