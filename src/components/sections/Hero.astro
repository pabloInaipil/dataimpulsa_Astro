---
// src/components/sections/Hero.astro
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config/site";
---

<section class="relative pt-28 pb-16 md:pt-36 md:pb-24 px-4 sm:px-6 overflow-hidden bg-(--color-deep)">
  <!-- Fondo con gradiente azul -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#0A1628] via-[#0B1D36] to-[#0F2744] pointer-events-none"></div>
  
  <!-- Patrón de puntos sutil -->
  <div class="absolute inset-0 opacity-30 pointer-events-none" style="background-image: radial-gradient(circle, rgba(59,130,246,0.15) 1px, transparent 1px); background-size: 28px 28px;"></div>

  <div class="relative z-10 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <!-- Columna izquierda: Texto -->
      <div class="text-center lg:text-left">
        <p class="text-accent text-xs md:text-sm font-semibold tracking-widest uppercase mb-4 font-display">
          Agencia Digital Chilena
        </p>
        
        <h1 class="text-4xl sm:text-5xl md:text-[3.4rem] font-bold leading-[1.1] tracking-tight text-white mb-6 font-display">
          Tu empresa visible,<br />
          automatizada e<br />
          <span class="text-white">inteligente</span>
        </h1>
        
        <p class="text-slate-300 text-base md:text-lg leading-relaxed mb-8 max-w-lg mx-auto lg:mx-0">
          Impulsamos el crecimiento de tu negocio con sitios web de alto rendimiento, datos que hablan y procesos inteligentes.
        </p>
        
        <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
          <a
            href={siteConfig.cta.href}
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg text-sm font-semibold text-white no-underline bg-accent hover:bg-accent-hover transition-all duration-300 shadow-lg shadow-blue-500/25"
          >
            Agendar reunión
            <Icon name="lucide:arrow-right" class="w-4 h-4" />
          </a>
          <a
            href="/#servicios"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg text-sm font-semibold text-white no-underline border border-white/25 hover:border-white/50 hover:bg-white/5 transition-all duration-300"
          >
            Conocer servicios
            <Icon name="lucide:minus" class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Columna derecha: Card Dashboard + Robot -->
      <div class="relative flex justify-center lg:justify-end overflow-visible">
        
        <!-- Card Dashboard — efecto en tiempo real -->
        <div class="relative w-full max-w-md bg-[#0F2744]/90 backdrop-blur-md border border-blue-500/20 rounded-2xl p-5 shadow-2xl shadow-blue-900/40 z-10 overflow-hidden live-card">
          
          <!-- Brillo animado de fondo -->
          <div class="absolute inset-0 live-glow pointer-events-none"></div>

          <div class="relative z-10">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-white text-sm font-semibold font-display">Vista de negocio en tiempo real</h3>
              <span class="flex items-center gap-1.5 text-xs text-emerald-400">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 live-dot"></span>
                Actualizado ahora
              </span>
            </div>
            
            <div class="grid grid-cols-3 gap-3 mb-5">
              <div class="bg-[#0A1628]/60 rounded-xl p-3 border border-white/5">
                <p class="text-[11px] text-slate-400 mb-1">Usuarios</p>
                <p class="text-xl font-bold text-white font-display" id="live-users">24.580</p>
                <p class="text-[11px] text-emerald-400">+12.5%</p>
              </div>
              <div class="bg-[#0A1628]/60 rounded-xl p-3 border border-white/5">
                <p class="text-[11px] text-slate-400 mb-1">Conversiones</p>
                <p class="text-xl font-bold text-white font-display" id="live-conv">3.42%</p>
                <p class="text-[11px] text-emerald-400">+8.1%</p>
              </div>
              <div class="bg-[#0A1628]/60 rounded-xl p-3 border border-white/5">
                <p class="text-[11px] text-slate-400 mb-1">Ingresos</p>
                <p class="text-xl font-bold text-white font-display" id="live-revenue">$128.7M</p>
                <p class="text-[11px] text-emerald-400">+15.3%</p>
              </div>
            </div>
            
            <!-- Mini chart animado -->
            <div class="h-20 w-full relative">
              <svg viewBox="0 0 300 80" class="w-full h-full" preserveAspectRatio="none" id="live-chart">
                <defs>
                  <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.45"/>
                    <stop offset="100%" stop-color="#3B82F6" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <path id="chart-area" fill="url(#chartGradient)" d=""/>
                <path id="chart-line" fill="none" stroke="#3B82F6" stroke-width="2.5" stroke-linecap="round" d=""/>
                <circle id="chart-dot" r="4" fill="#60A5FA" class="live-chart-dot">
                  <animate attributeName="r" values="3;5;3" dur="1.4s" repeatCount="indefinite"/>
                </circle>
              </svg>
            </div>
          </div>
        </div>

        <!-- Brazo robótico — fuera de la card -->
        <div class="absolute right-[-60px] bottom-[-30px] md:right-[-80px] md:bottom-[-20px] w-32 md:w-44 pointer-events-none select-none z-0">
          <!-- <svg viewBox="0 0 220 260" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full drop-shadow-[0_20px_40px_rgba(37,99,235,0.35)]">
            <rect x="78" y="220" width="64" height="22" rx="5" fill="#1E3A8A"/>
            <rect x="88" y="200" width="44" height="24" rx="4" fill="#1D4ED8"/>
            <circle cx="110" cy="200" r="14" fill="#3B82F6"/>
            <circle cx="110" cy="200" r="7" fill="#93C5FD"/>
            <rect x="102" y="95" width="16" height="110" rx="5" fill="#2563EB"/>
            <circle cx="110" cy="95" r="13" fill="#60A5FA"/>
            <circle cx="110" cy="95" r="6" fill="#BFDBFE"/>
            <g transform="rotate(-42 110 95)">
              <rect x="102" y="20" width="16" height="85" rx="5" fill="#3B82F6"/>
            </g>
            <g transform="rotate(-42 110 95)">
              <circle cx="110" cy="22" r="11" fill="#60A5FA"/>
              <circle cx="110" cy="22" r="5" fill="#DBEAFE"/>
            </g>
            <g transform="rotate(-42 110 95)">
              <rect x="88" y="-8" width="44" height="28" rx="7" fill="#2563EB"/>
              <rect x="82" y="-18" width="12" height="22" rx="4" fill="#60A5FA"/>
              <rect x="126" y="-18" width="12" height="22" rx="4" fill="#60A5FA"/>
              <rect x="100" y="0" width="20" height="8" rx="2" fill="#93C5FD"/>
            </g>
            <circle cx="110" cy="200" r="3" fill="#BFDBFE" opacity="0.8"/>
            <circle cx="110" cy="95" r="2.5" fill="#EFF6FF" opacity="0.9"/>
          </svg>
        </div>-->
      </div>
    </div>
  </div>
</section>

<style>
  .live-dot {
    animation: live-pulse 1.4s ease-in-out infinite;
  }

  @keyframes live-pulse {
    0%, 100% { opacity: 1; transform: scale(1); box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5); }
    50% { opacity: 0.7; transform: scale(1.3); box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); }
  }

  .live-glow {
    background: radial-gradient(ellipse at 70% 20%, rgba(59, 130, 246, 0.12), transparent 60%);
    animation: glow-shift 6s ease-in-out infinite alternate;
  }

  @keyframes glow-shift {
    from { opacity: 0.6; transform: scale(1); }
    to { opacity: 1; transform: scale(1.05); }
  }

  .live-chart-dot {
    filter: drop-shadow(0 0 6px #3B82F6);
  }

  @media (prefers-reduced-motion: reduce) {
    .live-dot,
    .live-glow,
    .live-chart-dot {
      animation: none !important;
    }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) {
    const line = document.getElementById("chart-line");
    const area = document.getElementById("chart-area");
    const dot = document.getElementById("chart-dot");
    const usersEl = document.getElementById("live-users");
    const convEl = document.getElementById("live-conv");
    const revEl = document.getElementById("live-revenue");

    if (line && area && dot) {
      const baseY = [62, 55, 48, 52, 40, 35, 28, 32, 22, 18, 14, 10];
      const points = baseY.length;
      const stepX = 300 / (points - 1);

      let phase = 0;
      let users = 24580;
      let conv = 3.42;
      let revenue = 128.7;

      function buildPath() {
        const coords = baseY.map((y, i) => {
          const wave = Math.sin(phase + i * 0.7) * 4;
          return {
            x: i * stepX,
            y: Math.max(6, Math.min(72, y + wave)),
          };
        });

        const lineD = coords.map((p, i) => `${i === 0 ? "M" : "L"}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
        const areaD = `${lineD} L300,80 L0,80 Z`;

        line.setAttribute("d", lineD);
        area.setAttribute("d", areaD);

        const last = coords[coords.length - 1];
        dot.setAttribute("cx", String(last.x));
        dot.setAttribute("cy", String(last.y));
      }

      function tickNumbers() {
        users += Math.round((Math.random() - 0.45) * 12);
        conv = Math.max(3.1, Math.min(3.7, conv + (Math.random() - 0.5) * 0.04));
        revenue = Math.max(126, Math.min(132, revenue + (Math.random() - 0.5) * 0.15));

        if (usersEl) usersEl.textContent = users.toLocaleString("es-CL");
        if (convEl) convEl.textContent = conv.toFixed(2) + "%";
        if (revEl) revEl.textContent = "$" + revenue.toFixed(1) + "M";
      }

      function animateChart() {
        phase += 0.08;
        buildPath();
        requestAnimationFrame(animateChart);
      }

      buildPath();
      animateChart();
      setInterval(tickNumbers, 2200);
    }
  }
</script>