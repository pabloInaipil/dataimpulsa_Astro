---
// src/components/sections/Hero.astro
import { siteConfig } from "@/config/site";
---

<section class="relative min-h-screen flex items-center justify-center pt-36 pb-20 px-6 overflow-hidden">
  <!-- Horizonte curvo "amanecer" — 100% CSS (gradientes + border-radius), sin imágenes -->
  <div class="hero-horizon absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-4xl mx-auto text-center relative z-[1]">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-medium font-mono text-accent-light mb-8 border border-(--color-border-accent) bg-accent/10">
      <span class="badge-dot w-1.5 h-1.5 rounded-full bg-accent"></span>
      ⚡ Desarrollo web ultra rápido con Astro
    </div>

    <h1 class="text-[clamp(2.6rem,6vw,4.6rem)] font-extrabold leading-[1.08] tracking-tight mb-6">
      Sitios web hiper rápidos<br />
      con <span class="gradient-text">Astro.</span> 🚀
    </h1>

    <p class="text-lg md:text-xl text-(--color-text-secondary) leading-relaxed mb-10 max-w-[640px] mx-auto">
      Desarrollamos sitios web modernos, ligeros y escalables con Astro.
      Máximo rendimiento, SEO perfecto y experiencias increíbles.
    </p>

    <div class="flex gap-4 items-center justify-center flex-wrap">
      <a
        href={siteConfig.cta.href}
        class="inline-block px-7 py-3.5 rounded-lg text-sm font-semibold text-stone-900 no-underline transition-all duration-300 bg-accent hover:bg-accent-hover hover:-translate-y-0.5 hover:shadow-[0_10px_30px_var(--color-accent-glow-strong)]"
      >
        {siteConfig.cta.label}
      </a>
      <a
        href="/#casos"
        class="inline-block px-7 py-3.5 rounded-lg text-sm font-semibold text-(--color-text-primary) no-underline border border-(--color-border-subtle) bg-transparent transition-all duration-300 hover:border-(--color-border-accent)"
      >
        Ver casos de éxito →
      </a>
    </div>
  </div>
</section>

<style>
  .hero-horizon {
    /* Únicos knobs de ajuste: tamaño del disco y cuánto arco asoma */
    --horizon-size: max(200vw, 48rem);
    --horizon-visible: clamp(64px, 10vh, 170px);
  }

  /* Atmósfera: bloom que sube desde el horizonte.
     Dos capas del mismo gradiente tokenizado apiladas = núcleo más cálido
     sin introducir colores nuevos. */
  .hero-horizon::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: var(--horizon-visible);
    width: max(120vw, 56rem);
    height: clamp(20rem, 46vh, 34rem);
    transform: translate(-50%, 50%);
    background:
      radial-gradient(closest-side, var(--color-accent-glow-strong), transparent 72%),
      radial-gradient(closest-side, var(--color-accent-glow-strong), transparent 45%);
  }

  /* Disco "planeta": solo asoma el arco superior (border-radius 50% sobre un
     círculo de ~200vw). El relleno opaco ocluye el bloom bajo la línea del
     horizonte y funde a --color-deep hacia la sección siguiente. */
  .hero-horizon::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: var(--horizon-size);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, calc(100% - var(--horizon-visible)));
    background:
      radial-gradient(closest-side, transparent 88%, var(--color-accent-glow) 98%, var(--color-accent-glow-strong) 100%),
      var(--color-deep);
    border: 1px solid var(--color-accent);
    box-shadow:
      0 0 40px var(--color-accent-glow-strong),
      0 0 140px 40px var(--color-accent-glow),
      inset 0 0 80px var(--color-accent-glow);
  }

  .badge-dot {
    animation: blink 2s ease-in-out infinite;
  }
</style>
