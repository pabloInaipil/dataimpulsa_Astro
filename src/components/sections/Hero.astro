---
// src/components/sections/Hero.astro
import { siteConfig } from "@/config/site";
---

<section class="relative min-h-screen flex items-center justify-center pt-36 pb-20 px-6 overflow-hidden">
  <!-- Starfield: canvas vanilla, pintado antes que el horizonte para que el
       bloom lo atenúe y el disco opaco lo ocluya bajo la línea del horizonte.
       Oculto en theme light (no hay cielo nocturno) y con reduced-motion el
       script nunca lo inicializa. -->
  <canvas id="hero-stars" class="hero-stars absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>

  <!-- Horizonte curvo "amanecer" — 100% CSS (gradientes + border-radius), sin imágenes -->
  <div class="hero-horizon absolute inset-0 pointer-events-none" aria-hidden="true">
    <!-- Llamaradas: pulsos de gradiente sobre la cresta del arco. Duraciones
         primas entre sí para que el ciclo combinado no se perciba como loop.
         Base opacity:0 → con prefers-reduced-motion quedan invisibles solas. -->
    <div class="hero-flare hero-flare--a"></div>
    <div class="hero-flare hero-flare--b"></div>
    <div class="hero-flare hero-flare--c"></div>
    <!-- Halos: anillos elípticos que se expanden desde la cresta. Pintados
         antes del ::after (disco), así su mitad inferior queda ocluida y solo
         se ve el arco superior emanando del sol. -->
    <div class="hero-halo hero-halo--1"></div>
    <div class="hero-halo hero-halo--2"></div>
  </div>

  <div class="max-w-4xl mx-auto text-center relative z-[1]">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-medium font-mono text-accent-light mb-8 border border-(--color-border-accent) bg-accent/10">
      <span class="badge-dot w-1.5 h-1.5 rounded-full bg-accent"></span>
      ⚡ Desarrollo web ultra rápido con Astro
    </div>

    <h1 class="text-[clamp(2.6rem,6vw,4.6rem)] font-extrabold leading-[1.08] tracking-tight mb-6">
      Sitios web hiper rápidos<br />
      con <span class="gradient-text">Astro.</span> 🚀
    </h1>

    <p class="text-lg md:text-xl text-(--color-text-secondary) leading-relaxed mb-10 max-w-[640px] mx-auto">
      Desarrollamos sitios web modernos, ligeros y escalables con Astro.
      Máximo rendimiento, SEO perfecto y experiencias increíbles.
    </p>

    <div class="flex gap-4 items-center justify-center flex-wrap">
      <a
        href={siteConfig.cta.href}
        class="inline-block px-7 py-3.5 rounded-lg text-sm font-semibold text-stone-900 no-underline transition-all duration-300 bg-accent hover:bg-accent-hover hover:-translate-y-0.5 hover:shadow-[0_10px_30px_var(--color-accent-glow-strong)]"
      >
        {siteConfig.cta.label}
      </a>
      <a
        href="/#casos"
        class="inline-block px-7 py-3.5 rounded-lg text-sm font-semibold text-(--color-text-primary) no-underline border border-(--color-border-subtle) bg-transparent transition-all duration-300 hover:border-(--color-border-accent)"
      >
        Ver casos de éxito →
      </a>
    </div>
  </div>
</section>

<style>
  .hero-horizon {
    /* Únicos knobs de ajuste: tamaño del disco y cuánto arco asoma */
    --horizon-size: max(200vw, 48rem);
    --horizon-visible: clamp(64px, 10vh, 170px);
  }

  /* Atmósfera: bloom que sube desde el horizonte.
     Dos capas del mismo gradiente tokenizado apiladas = núcleo más cálido
     sin introducir colores nuevos. */
  .hero-horizon::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: var(--horizon-visible);
    width: max(120vw, 56rem);
    height: clamp(20rem, 46vh, 34rem);
    transform: translate(-50%, 50%);
    background:
      radial-gradient(closest-side, var(--color-accent-glow-strong), transparent 72%),
      radial-gradient(closest-side, var(--color-accent-glow-strong), transparent 45%);
  }

  /* Disco "planeta": solo asoma el arco superior (border-radius 50% sobre un
     círculo de ~200vw). El relleno opaco ocluye el bloom bajo la línea del
     horizonte y funde a --color-deep hacia la sección siguiente. */
  .hero-horizon::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: var(--horizon-size);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, calc(100% - var(--horizon-visible)));
    background:
      radial-gradient(closest-side, transparent 88%, var(--color-accent-glow) 98%, var(--color-accent-glow-strong) 100%),
      var(--color-deep);
    border: 1px solid var(--color-accent);
    box-shadow:
      0 0 40px var(--color-accent-glow-strong),
      0 0 140px 40px var(--color-accent-glow),
      inset 0 0 80px var(--color-accent-glow);
  }

  /* El starfield es estética de cielo nocturno: en light theme se oculta.
     display:none dispara el IntersectionObserver del script (no-intersecting)
     y el loop rAF se pausa solo. */
  :global(html.light) .hero-stars {
    display: none;
  }

  /* ===== Llamaradas ===== */
  /* Blobs de gradiente anclados a la cresta. Solo animan transform/opacity
     (compositor). Opacidad base 0: sin animación (reduced-motion) no existen
     visualmente y el hero queda idéntico al estático actual. */
  .hero-flare {
    position: absolute;
    bottom: var(--horizon-visible);
    aspect-ratio: 1.6;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--color-accent-glow-strong), transparent 70%);
    opacity: 0;
    transform: translate(-50%, 50%);
  }
  .hero-flare--a {
    left: 32%;
    width: clamp(10rem, 22vw, 18rem);
  }
  .hero-flare--b {
    left: 50%;
    width: clamp(14rem, 30vw, 26rem);
  }
  .hero-flare--c {
    left: 69%;
    width: clamp(9rem, 18vw, 15rem);
  }

  /* ===== Halos ===== */
  /* Anillos elípticos centrados en la cresta; el disco (::after) pinta encima
     y ocluye su mitad inferior → solo el arco superior emana del sol. */
  .hero-halo {
    position: absolute;
    left: 50%;
    bottom: var(--horizon-visible);
    width: clamp(22rem, 52vw, 46rem);
    aspect-ratio: 2.8;
    border-radius: 50%;
    border: 1px solid var(--color-accent);
    box-shadow:
      0 0 24px var(--color-accent-glow),
      inset 0 0 18px var(--color-accent-glow);
    opacity: 0;
    transform: translate(-50%, 50%) scale(0.25);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Respiración del bloom atmosférico */
    .hero-horizon::before {
      animation: hero-bloom 9s ease-in-out infinite alternate;
    }
    .hero-flare--a {
      animation: hero-flare 7s ease-in-out infinite alternate;
      animation-delay: -2s;
    }
    .hero-flare--b {
      animation: hero-flare 11s ease-in-out infinite alternate;
      animation-delay: -5s;
    }
    .hero-flare--c {
      animation: hero-flare 9s ease-in-out infinite alternate;
      animation-delay: -8s;
    }
    .hero-halo--1 {
      animation: hero-halo 9s ease-out infinite;
    }
    .hero-halo--2 {
      animation: hero-halo 9s ease-out infinite;
      animation-delay: -4.5s;
    }
  }

  @keyframes hero-bloom {
    from {
      opacity: 0.78;
      transform: translate(-50%, 50%) scale(1);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 50%) scale(1.06);
    }
  }

  @keyframes hero-flare {
    from {
      opacity: 0.1;
      transform: translate(-50%, 50%) scale(0.92);
    }
    to {
      opacity: 0.55;
      transform: translate(-50%, 50%) scale(1.12);
    }
  }

  @keyframes hero-halo {
    0% {
      opacity: 0;
      transform: translate(-50%, 50%) scale(0.25);
    }
    14% {
      opacity: 0.35;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, 50%) scale(1.55);
    }
  }

  .badge-dot {
    animation: blink 2s ease-in-out infinite;
  }
</style>

<script>
  // Starfield del hero: canvas vanilla, sin librerías.
  // Presupuesto: <1ms/frame desktop (~130 estrellas), <0.5ms mobile (~45).
  // Se pausa fuera de viewport (IntersectionObserver) y no se inicializa con
  // prefers-reduced-motion. El init corre en idle para no competir con el LCP.
  const canvas = document.getElementById("hero-stars") as HTMLCanvasElement | null;

  if (canvas && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const start = () => initStars(canvas);
    if ("requestIdleCallback" in window) {
      requestIdleCallback(start, { timeout: 2000 });
    } else {
      setTimeout(start, 300);
    }
  }

  function initStars(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const coarse = matchMedia("(pointer: coarse)").matches || innerWidth < 768;
    const dpr = Math.min(devicePixelRatio || 1, coarse ? 1 : 1.5);
    const MAX_SHIFT = 12; // px de parallax en la capa más cercana

    // Colores desde las CSS vars del theme (regla de paleta del proyecto).
    // El canvas solo existe en dark, así que basta leerlos una vez.
    const rootStyle = getComputedStyle(document.documentElement);
    const starColor = rootStyle.getPropertyValue("--color-text-primary").trim() || "#f5f5f4";
    const tintColor = rootStyle.getPropertyValue("--color-accent-light").trim() || "#fb923c";

    // Un sprite pre-renderizado por color: núcleo sólido + falloff suave.
    // drawImage de un sprite chico es más barato que arc()+fill por estrella.
    const makeSprite = (color: string) => {
      const s = document.createElement("canvas");
      s.width = s.height = 32;
      const sc = s.getContext("2d")!;
      const g = sc.createRadialGradient(16, 16, 0, 16, 16, 16);
      g.addColorStop(0, color);
      g.addColorStop(0.35, color);
      g.addColorStop(1, "transparent");
      sc.fillStyle = g;
      sc.fillRect(0, 0, 32, 32);
      return s;
    };
    const spriteWhite = makeSprite(starColor);
    const spriteTint = makeSprite(tintColor);

    type Star = {
      x: number; y: number; r: number; depth: number;
      base: number; amp: number; speed: number; phase: number;
      dx: number; dy: number; sprite: HTMLCanvasElement;
    };

    let stars: Star[] = [];
    let w = 0;
    let h = 0;

    const build = () => {
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const cap = coarse ? 45 : 130;
      const count = Math.min(cap, Math.round((w * h) / 14000));
      stars = [];
      for (let i = 0; i < count; i++) {
        const bright = Math.random() < 0.1; // pocas estrellas grandes y brillantes
        const depth = 0.3 + Math.random() * 0.7;
        stars.push({
          x: Math.random() * w,
          y: Math.random() * h * 0.82, // solo el espacio negro superior
          r: bright ? 1.6 + Math.random() * 1.6 : 0.6 + Math.random() * 1.1,
          depth,
          base: bright ? 0.75 : 0.35 + Math.random() * 0.3,
          amp: 0.12 + Math.random() * 0.18,
          speed: 0.0004 + Math.random() * 0.0008,
          phase: Math.random() * Math.PI * 2,
          // Deriva mínima solo en touch (sin parallax): vida a costo ~0
          dx: coarse ? (Math.random() - 0.5) * 0.012 : 0,
          dy: coarse ? -Math.random() * 0.006 : 0,
          sprite: Math.random() < 0.15 ? spriteTint : spriteWhite,
        });
      }
    };
    build();

    // Parallax: el listener solo guarda el target normalizado (-1..1);
    // el loop rAF ya activo hace el lerp → throttle natural por frame.
    let targetX = 0;
    let targetY = 0;
    let curX = 0;
    let curY = 0;
    if (matchMedia("(pointer: fine)").matches) {
      addEventListener(
        "pointermove",
        (e) => {
          targetX = (e.clientX / innerWidth) * 2 - 1;
          targetY = (e.clientY / innerHeight) * 2 - 1;
        },
        { passive: true }
      );
    }

    let raf = 0;
    const frame = (t: number) => {
      raf = requestAnimationFrame(frame);
      curX += (targetX - curX) * 0.05;
      curY += (targetY - curY) * 0.05;

      ctx.clearRect(0, 0, w, h);
      for (const s of stars) {
        if (s.dx !== 0 || s.dy !== 0) {
          s.x = (s.x + s.dx + w) % w;
          s.y = (s.y + s.dy + h) % h;
        }
        ctx.globalAlpha = Math.max(
          0,
          s.base + Math.sin(t * s.speed + s.phase) * s.amp
        );
        const px = s.x + curX * MAX_SHIFT * s.depth;
        const py = s.y + curY * MAX_SHIFT * s.depth;
        const d = s.r * 2;
        ctx.drawImage(s.sprite, px - s.r, py - s.r, d, d);
      }
    };

    // Pausa fuera de viewport (protege TBT al scrollear). display:none del
    // theme light también cae acá: el IO reporta no-intersecting.
    const io = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        if (!raf) raf = requestAnimationFrame(frame);
      } else {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    });
    io.observe(canvas);

    // Re-init debounced; ignora el resize menor de la URL bar mobile al scrollear.
    let lastW = w;
    let lastH = h;
    let timer = 0;
    addEventListener(
      "resize",
      () => {
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          const cw = canvas.clientWidth;
          const ch = canvas.clientHeight;
          if (cw === lastW && Math.abs(ch - lastH) < 120) return;
          lastW = cw;
          lastH = ch;
          build();
        }, 150);
      },
      { passive: true }
    );
  }
</script>
