---
// src/components/sections/DataServices.astro
// Línea complementaria (~30%): automatización IA, scraping y análisis de datos.
// Carrusel auto-rotatorio (6s) con pausa en hover/foco y soporte reduced-motion.
import { siteConfig } from "@/config/site";

const { data } = siteConfig.services;

// Íconos y tags de presentación para cada item de siteConfig.services.data
const cardExtras = [
  {
    tag: "AGENTES · RPA · FLUJOS",
    paths: [
      "M9 2v3",
      "M15 2v3",
      "M9 19v3",
      "M15 19v3",
      "M2 9h3",
      "M2 15h3",
      "M19 9h3",
      "M19 15h3",
      "M6.5 5h11A1.5 1.5 0 0 1 19 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 17.5v-11A1.5 1.5 0 0 1 6.5 5Z",
      "M9.5 9.5h5v5h-5Z",
    ],
  },
  {
    tag: "PRECIOS · COMPETENCIA · CATÁLOGOS",
    paths: [
      "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z",
      "M2 12h20",
      "M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z",
    ],
  },
  {
    tag: "DASHBOARDS · DAX · ETL",
    paths: ["M3 3v18h18", "M8 17v-6", "M13 17V7", "M18 17v-9"],
  },
  {
    tag: "REPORTES · KPIs · DECISIONES",
    paths: ["M21.2 15.9A10 10 0 1 1 8 2.8", "M22 12A10 10 0 0 0 12 2v10Z"],
  },
];

const cards = data.items.map((item, i) => ({ ...item, ...cardExtras[i] }));
---

<section id="datos" class="relative z-[1] py-24 px-6 bg-(--color-surface)/50 border-t border-b border-(--color-border-subtle) overflow-hidden">
  <!-- Glow sutil que conecta con el resto del sitio -->
  <div class="data-glow absolute -top-[200px] -right-[250px] w-[600px] h-[600px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14 reveal">
      <div>
        <div class="text-xs font-mono font-medium tracking-widest uppercase text-accent-light mb-3">
          // Datos & IA
        </div>
        <h2 class="text-[clamp(2rem,3.5vw,2.8rem)] font-bold tracking-tight leading-tight max-w-2xl">
          Más que sitios web: impulsamos tu negocio <span class="gradient-text">con datos e IA</span>
        </h2>
      </div>
      <p class="text-lg text-(--color-text-secondary) leading-relaxed max-w-sm lg:text-right">
        {data.description}
      </p>
    </div>

    <!-- Carrusel de servicios -->
    <div
      class="relative mb-12 reveal"
      role="region"
      aria-roledescription="carrusel"
      aria-label="Servicios de datos e inteligencia artificial"
      data-carousel
    >
      <!-- Track: las 4 slides apiladas en la misma celda; el contenedor
           toma la altura de la más alta, así la rotación no salta. -->
      <div class="grid lg:px-16">
        {cards.map((card, i) => (
          <div
            class:list={["slide col-start-1 row-start-1 flex justify-center", i === 0 && "is-active"]}
            role="group"
            aria-roledescription="diapositiva"
            aria-label={`${i + 1} de ${cards.length}`}
            aria-hidden={i === 0 ? "false" : "true"}
            data-slide
          >
            <div
              class:list={[
                "group w-full max-w-2xl h-full bg-(--color-card) border border-(--color-border-subtle) rounded-2xl p-7 sm:p-10 flex flex-col",
                "transition-all duration-400 hover:border-(--color-border-accent)",
                "hover:shadow-[0_20px_60px_rgba(0,0,0,0.3),0_0_30px_var(--color-accent-glow)]",
              ]}
            >
              <div class="w-12 h-12 rounded-xl grid place-items-center mb-6 border border-(--color-border-accent) bg-accent/10 text-accent">
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {card.paths.map((d) => <path d={d}></path>)}
                </svg>
              </div>
              <h3 class="text-xl font-semibold mb-3">{card.title}</h3>
              <p class="text-(--color-text-secondary) leading-relaxed">{card.description}</p>
              <div class="mt-auto pt-5">
                <div class="border-t border-(--color-border-subtle) pt-4 text-[0.6rem] font-mono tracking-widest text-(--color-text-muted)">
                  {card.tag}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Flechas (solo desktop; en mobile quedan los dots) -->
      <button
        type="button"
        data-prev
        aria-label="Servicio anterior"
        class="hidden lg:grid place-items-center absolute left-0 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full border border-(--color-border-subtle) bg-(--color-card) text-(--color-text-secondary) transition-colors duration-300 hover:text-accent hover:border-(--color-border-accent) cursor-pointer"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>
      <button
        type="button"
        data-next
        aria-label="Servicio siguiente"
        class="hidden lg:grid place-items-center absolute right-0 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full border border-(--color-border-subtle) bg-(--color-card) text-(--color-text-secondary) transition-colors duration-300 hover:text-accent hover:border-(--color-border-accent) cursor-pointer"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>

      <!-- Dots -->
      <div class="flex justify-center gap-1 mt-6">
        {cards.map((card, i) => (
          <button
            type="button"
            data-dot
            aria-label={`Ir a slide ${i + 1}: ${card.title}`}
            aria-current={i === 0 ? "true" : undefined}
            class="dot grid place-items-center w-11 h-11 cursor-pointer"
          >
            <span class="dot-mark block w-2.5 h-2.5 rounded-full bg-(--color-border-subtle) transition-all duration-300"></span>
          </button>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center reveal">
      <a
        href={siteConfig.ctaData.href}
        class="inline-block px-7 py-3.5 rounded-lg text-sm font-semibold text-white no-underline transition-all duration-300 bg-accent hover:bg-accent-hover hover:-translate-y-0.5 hover:shadow-[0_10px_30px_var(--color-accent-glow-strong)]"
      >
        {siteConfig.ctaData.label}
      </a>
    </div>
  </div>
</section>

<style>
  .data-glow {
    background-image: radial-gradient(
      circle,
      var(--color-accent-glow) 0%,
      transparent 70%
    );
  }

  /* Estado de las slides: todas en el DOM, solo la activa es visible.
     visibility oculta las inactivas también del árbol de accesibilidad. */
  .slide {
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease,
      visibility 0s linear 0.5s;
  }
  .slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease,
      visibility 0s;
  }

  .dot[aria-current="true"] .dot-mark {
    background-color: var(--color-accent);
    width: 1.5rem;
  }
  .dot:hover .dot-mark,
  .dot:focus-visible .dot-mark {
    background-color: var(--color-accent-light);
  }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide.is-active {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function setupCarousel() {
    const root = document.querySelector<HTMLElement>("[data-carousel]");
    if (!root) return;

    const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const INTERVAL = 6000;
    let current = 0;
    let timer: number | undefined;

    function goTo(index: number) {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === current);
        slide.setAttribute("aria-hidden", String(i !== current));
      });
      dots.forEach((dot, i) => {
        if (i === current) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    }

    function start() {
      if (reducedMotion.matches || timer !== undefined) return;
      if (root.contains(document.activeElement)) return;
      timer = window.setInterval(() => goTo(current + 1), INTERVAL);
    }

    function stop() {
      window.clearInterval(timer);
      timer = undefined;
    }

    function restart() {
      stop();
      start();
    }

    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        goTo(i);
        restart();
      })
    );
    prev?.addEventListener("click", () => {
      goTo(current - 1);
      restart();
    });
    next?.addEventListener("click", () => {
      goTo(current + 1);
      restart();
    });

    // Pausa en hover y en foco de teclado; reanuda al salir.
    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) start();
    });

    reducedMotion.addEventListener("change", () => {
      if (reducedMotion.matches) stop();
      else start();
    });

    start();
  }

  setupCarousel();
</script>
