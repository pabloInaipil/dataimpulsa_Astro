---
// src/components/sections/DataServices.astro
// Línea complementaria (~30%): automatización IA, scraping y análisis de datos.
// Grilla 2×2 (1 col en mobile) que muestra los 4 servicios simultáneamente,
// con "Automatización con IA" como card destacada. Sin JS.
import { siteConfig } from "@/config/site";

const { data } = siteConfig.services;

// Íconos y tags de presentación para cada item de siteConfig.services.data
const cardExtras = [
  {
    tag: "AGENTES · RPA · FLUJOS",
    paths: [
      "M9 2v3",
      "M15 2v3",
      "M9 19v3",
      "M15 19v3",
      "M2 9h3",
      "M2 15h3",
      "M19 9h3",
      "M19 15h3",
      "M6.5 5h11A1.5 1.5 0 0 1 19 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 17.5v-11A1.5 1.5 0 0 1 6.5 5Z",
      "M9.5 9.5h5v5h-5Z",
    ],
  },
  {
    tag: "PRECIOS · COMPETENCIA · CATÁLOGOS",
    paths: [
      "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z",
      "M2 12h20",
      "M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z",
    ],
  },
  {
    tag: "DASHBOARDS · DAX · ETL",
    paths: ["M3 3v18h18", "M8 17v-6", "M13 17V7", "M18 17v-9"],
  },
  {
    tag: "REPORTES · KPIs · DECISIONES",
    paths: ["M21.2 15.9A10 10 0 1 1 8 2.8", "M22 12A10 10 0 0 0 12 2v10Z"],
  },
];

// La primera card (Automatización con IA) lleva jerarquía destacada.
const cards = data.items.map((item, i) => ({
  ...item,
  ...cardExtras[i],
  featured: i === 0,
}));
---

<section id="datos" class="relative z-[1] py-24 px-6 bg-(--color-surface)/50 border-t border-b border-(--color-border-subtle) overflow-hidden">
  <!-- Glow sutil que conecta con el resto del sitio -->
  <div class="data-glow absolute -top-[200px] -right-[250px] w-[600px] h-[600px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14 reveal">
      <div>
        <div class="text-xs font-display font-medium tracking-widest uppercase text-accent-light mb-3">
          // Datos & IA
        </div>
        <h2 class="text-[clamp(2rem,3.5vw,2.8rem)] font-bold tracking-tight leading-tight max-w-2xl">
          Más que sitios web: impulsamos tu negocio <span class="gradient-text">con datos e IA</span>
        </h2>
      </div>
      <p class="text-lg text-(--color-text-secondary) leading-relaxed max-w-sm lg:text-right">
        {data.description}
      </p>
    </div>

    <!-- Grilla de servicios: los 4 visibles de una -->
    <div class="grid md:grid-cols-2 gap-4 md:gap-6 mb-12 reveal">
      {cards.map((card) => (
        <article
          class:list={[
            "group flex flex-col rounded-2xl p-6 md:p-8 transition-all duration-400",
            "hover:shadow-[0_20px_60px_rgba(0,0,0,0.3),0_0_30px_var(--color-accent-glow)]",
            card.featured
              ? "border border-(--color-border-accent) bg-(--color-card) bg-linear-to-br from-accent/10 via-transparent to-transparent"
              : "border border-(--color-border-subtle) bg-(--color-card) hover:border-(--color-border-accent)",
          ]}
        >
          <div class="flex items-start justify-between mb-6">
            <div class="w-12 h-12 rounded-xl grid place-items-center border border-(--color-border-accent) bg-accent/10 text-accent">
              <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {card.paths.map((d) => <path d={d}></path>)}
              </svg>
            </div>
            {card.featured && (
              <span class="text-[0.6rem] font-display font-medium tracking-widest uppercase text-accent-light border border-(--color-border-accent) rounded-full px-3 py-1.5">
                Foco 2026
              </span>
            )}
          </div>
          <h3 class="text-xl font-semibold mb-3">{card.title}</h3>
          <p class="text-(--color-text-secondary) leading-relaxed">{card.description}</p>
          <div class="mt-auto pt-5">
            <div class="border-t border-(--color-border-subtle) pt-4 text-[0.6rem] font-display tracking-widest text-(--color-text-muted)">
              {card.tag}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center reveal">
      <a
        href={siteConfig.ctaData.href}
        class="inline-block px-7 py-3.5 rounded-lg text-sm font-semibold text-stone-900 no-underline transition-all duration-300 bg-accent hover:bg-accent-hover hover:-translate-y-0.5 hover:shadow-[0_10px_30px_var(--color-accent-glow-strong)]"
      >
        {siteConfig.ctaData.label}
      </a>
    </div>
  </div>
</section>

<style>
  .data-glow {
    background-image: radial-gradient(
      circle,
      var(--color-accent-glow) 0%,
      transparent 70%
    );
  }
</style>
