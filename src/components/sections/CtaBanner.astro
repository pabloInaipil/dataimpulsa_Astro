---
// src/components/sections/CtaBanner.astro
// Banner de cierre que cubre ambas líneas de servicio.
import { siteConfig } from "@/config/site";
---

<section class="relative z-[1] py-24 px-6">
  <div class="cta-panel glow-line-top relative max-w-5xl mx-auto rounded-3xl border border-(--color-border-accent) p-10 md:p-16 text-center overflow-hidden reveal">
    <h2 class="text-[clamp(2rem,4vw,3rem)] font-extrabold tracking-tight leading-tight mb-5">
      ¿Listo para <span class="gradient-text">impulsar tu negocio</span>?
    </h2>
    <p class="text-lg text-(--color-text-secondary) leading-relaxed max-w-2xl mx-auto mb-10">
      Sitios web hiper rápidos con Astro y soluciones de datos e IA que trabajan
      por ti. Conversemos, sin compromiso.
    </p>

    <div class="flex gap-4 items-center justify-center flex-wrap">
      <a
        href={siteConfig.cta.href}
        class="inline-block px-7 py-3.5 rounded-lg text-sm font-semibold text-stone-900 no-underline transition-all duration-300 bg-accent hover:bg-accent-hover hover:-translate-y-0.5 hover:shadow-[0_10px_30px_var(--color-accent-glow-strong)]"
      >
        {siteConfig.cta.label}
      </a>
      <a
        href={siteConfig.ctaData.href}
        class="inline-block px-7 py-3.5 rounded-lg text-sm font-semibold text-(--color-text-primary) no-underline border border-(--color-border-subtle) transition-all duration-300 hover:border-(--color-border-accent) hover:text-accent-light"
      >
        {siteConfig.ctaData.label}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-panel {
    background-image: linear-gradient(
      160deg,
      var(--color-accent-glow) 0%,
      transparent 45%
    );
    background-color: var(--color-card);
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
  }
</style>
