---
// src/components/sections/Contact.astro
import { siteConfig } from "@/config/site";

const inputClasses =
  "w-full px-4 py-3 bg-(--color-surface) border border-(--color-border-subtle) rounded-lg text-(--color-text-primary) text-sm outline-none transition-all duration-200 focus:border-accent focus:shadow-[0_0_0_3px_var(--color-accent-glow)]";
---

<section id="contacto" class="relative z-[1] py-24 px-6 bg-(--color-surface)">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16 reveal">
      <div class="text-xs font-display font-medium tracking-widest uppercase text-accent-light mb-3">
        // Contacto
      </div>
      <h2 class="text-[clamp(2rem,3.5vw,2.8rem)] font-bold tracking-tight mb-4">
        Conversemos sobre tu próximo proyecto
      </h2>
      <p class="text-lg text-(--color-text-secondary) max-w-xl mx-auto leading-relaxed">
        Sitio web, automatización o datos: cuéntanos qué necesitas. Sin compromiso.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 reveal">
      <!-- Info Column -->
      <div>
        <h3 class="text-2xl font-bold mb-4">Escríbenos directamente</h3>
        <p class="text-(--color-text-secondary) leading-relaxed mb-8">
          Agenda una consulta gratuita: te mostraremos cómo un sitio ultra rápido
          o una solución de datos puede llevar tu operación al siguiente nivel.
        </p>

        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center text-base shrink-0 border border-(--color-border-accent) bg-accent/10">
              ✉
            </div>
            <span class="text-(--color-text-secondary)">{siteConfig.email}</span>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center text-base shrink-0 border border-(--color-border-accent) bg-accent/10">
              📱
            </div>
            <span class="text-(--color-text-secondary)">{siteConfig.phone}</span>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center text-base shrink-0 border border-(--color-border-accent) bg-accent/10">
              📍
            </div>
            <span class="text-(--color-text-secondary)">{siteConfig.address}</span>
          </div>
        </div>
      </div>

      <!-- Form Column (Web3Forms) -->
      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="bg-(--color-card) border border-(--color-border-subtle) rounded-2xl p-8"
      >
        <input type="hidden" name="access_key" value={siteConfig.web3formsKey} />
        <input type="hidden" name="subject" value="Nuevo contacto desde dataimpulsa.cl" />
        <input type="hidden" name="from_name" value="DatAImpulsa Web" />
        <input type="checkbox" name="botcheck" class="hidden" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div>
            <label for="nombre" class="block text-xs text-(--color-text-muted) font-medium mb-1.5">Nombre</label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              placeholder="Tu nombre"
              class={inputClasses}
            />
          </div>
          <div>
            <label for="empresa" class="block text-xs text-(--color-text-muted) font-medium mb-1.5">Empresa</label>
            <input
              type="text"
              id="empresa"
              name="empresa"
              placeholder="Nombre de tu empresa"
              class={inputClasses}
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div>
            <label for="email" class="block text-xs text-(--color-text-muted) font-medium mb-1.5">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="tu@email.com"
              class={inputClasses}
            />
          </div>
          <div>
            <label for="telefono" class="block text-xs text-(--color-text-muted) font-medium mb-1.5">Teléfono</label>
            <input
              type="tel"
              id="telefono"
              name="telefono"
              placeholder="+56 9 ..."
              class={inputClasses}
            />
          </div>
        </div>

        <div class="mb-6">
          <label for="mensaje" class="block text-xs text-(--color-text-muted) font-medium mb-1.5">Mensaje</label>
          <textarea
            id="mensaje"
            name="mensaje"
            required
            rows="4"
            placeholder="Cuéntanos sobre tu proyecto..."
            class:list={[inputClasses, "resize-y"]}
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3.5 rounded-lg text-sm font-semibold text-stone-900 border-none cursor-pointer transition-all duration-300 bg-accent hover:bg-accent-hover hover:-translate-y-0.5 hover:shadow-[0_10px_30px_var(--color-accent-glow-strong)]"
        >
          Enviar mensaje →
        </button>
      </form>
    </div>
  </div>
</section>
